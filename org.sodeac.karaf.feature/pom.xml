<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.icg-software</groupId>
        <artifactId>osgi-parent</artifactId>
        <version>2.0.0-SNAPSHOT</version>
    </parent>

    <groupId>org.sodeac</groupId>
    <artifactId>org.sodeac.karaf.feature</artifactId>
    <version>2.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Sodeac feature</name>
    <description>Sodeac Karaf Feature</description>

    <properties>
        <!-- only needed for features.xml -->
        <!-- Sodeac: transitive prerequisites -->
        <sodeac.multichainlist.version>1.0.1</sodeac.multichainlist.version>
        <sodeac.xuri.version>1.0.0</sodeac.xuri.version>
        <dropwizard.metrics.version>3.2.6</dropwizard.metrics.version>

        <!-- Jackson: annotations uses major.minor only (since Jackson 2.20) -->
        <jackson-annotations.version>2.21</jackson-annotations.version>

        <artemis.version>2.53.0</artemis.version>
        <!-- netty version from feature artemis-jakarta-client -->
        <netty.version>4.1.131.Final</netty.version>
        <pooled-jms.version>3.2.2</pooled-jms.version>

        <hawtio.version>2.17.7</hawtio.version>

        <!-- https://mvnrepository.com/artifact/org.apache.cxf.karaf/apache-cxf/versions -->
        <cxf.version>3.6.11</cxf.version>
        <annotation-api-1.3.version>1.3_3</annotation-api-1.3.version>

        <!-- apache commons, rest -->
        <commons-configuration2.version>2.15.0</commons-configuration2.version>
        <commons-csv.version>1.14.1</commons-csv.version>
        <commons-dbutils.version>1.8.1</commons-dbutils.version>
        <commons-codec.version>1.22.0</commons-codec.version>
        <commons-net.version>3.13.0</commons-net.version>
        <commons-math3.version>3.6.1</commons-math3.version>
        <commons-collections.version>3.2.2</commons-collections.version>
        <commons-logging.version>1.3.6</commons-logging.version>
        <commons-jexl3.version>3.6.2</commons-jexl3.version>
        <commons-cli.version>1.11.0</commons-cli.version>

        <commons-httpcore>4.4.16</commons-httpcore>
        <commons-httpclient>4.5.14</commons-httpclient>
        <commons-httpasyncclient>4.1.5</commons-httpasyncclient>
        <jcifs-ng.version>2.1.10</jcifs-ng.version>

        <!-- for Jackson -->
        <validation-api-1.version>1.1.0.Final</validation-api-1.version>

        <!-- not yet needed -->
        <h2.1.4.version>1.4.200</h2.1.4.version>
        <h2.2.0.version>2.0.206</h2.2.0.version>
        <dom4j-2.version>2.1.4_1</dom4j-2.version>

        <!-- for Tritom -->
        <firebird.3.version>3.0.12</firebird.3.version>
        <firebird.4.version>4.0.5.java8</firebird.4.version>
        <firebird.4.export.version>4.0.5</firebird.4.export.version>
        <!-- <sqlserver.version>9.4.1.jre8</sqlserver.version> -->

        <!-- bsx2-security -->
        <!-- same version as karaf 4.4.10 -->
        <bouncycastle.version>1.83</bouncycastle.version>
        <jjwt.version>0.13.0</jjwt.version>

        <!-- bsx2-jaxws -->
        <servicemix-jaxws-2.3.version>2.3_3</servicemix-jaxws-2.3.version>
        <servicemix-saaj-api-1.4-version>1.4_2</servicemix-saaj-api-1.4-version>
    </properties>

    <build>
        <plugins>
            <!-- Process and attach features.xml as Maven artifact (type=xml, classifier=features) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>filter-features</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>resources</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>attach-features</id>
                        <phase>package</phase>
                        <goals>
                            <goal>attach-artifact</goal>
                        </goals>
                        <configuration>
                            <artifacts>
                                <artifact>
                                    <file>${project.build.outputDirectory}/features.xml</file>
                                    <type>xml</type>
                                    <classifier>features</classifier>
                                </artifact>
                            </artifacts>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>

