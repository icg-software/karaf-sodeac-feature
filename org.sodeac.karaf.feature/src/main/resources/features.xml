<?xml version="1.0" encoding="UTF-8"?>
<features name="${project.artifactId}-${project.version}"
    xmlns="http://karaf.apache.org/xmlns/features/v1.6.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://karaf.apache.org/xmlns/features/v1.6.0 https://karaf.apache.org/xmlns/features/v1.6.0">

    <repository>mvn:org.apache.camel.karaf/apache-camel/${camel.version}/xml/features</repository>
    <repository>mvn:org.apache.artemis/artemis-features/${artemis.version}/xml/features</repository>
    <repository>mvn:io.hawt/hawtio-karaf/${hawtio.version}/xml/features</repository>
    <repository>mvn:org.apache.cxf.karaf/apache-cxf/${cxf.version}/xml/features</repository>

    <feature name="sodeac-standalone" description="Full standalone stack: BSX core + optional extensions" version="${pom.version}">
        <feature>bsx</feature>
        <feature>bsx2</feature>
    </feature>

    <feature name="bsx" version="${project.version}" description="Core BSX feature — base bundles required by all BSX projects" start-level="76">
        <feature>bsx-base</feature>
        <feature>bsx-sodeac</feature>
        <feature>bsx-camel</feature>
        <feature>bsx-apache-commons</feature>
        <feature>bsx-jackson</feature>
        <feature>bsx-database</feature>
        <feature>bsx-jms</feature>

        <!-- separate bsx-core project -->
        <bundle>mvn:com.icg-software/com.icg-software.bsx.core/${bsx.core.version}</bundle>
        <!-- bs:bsx-core projects + bsx-base-eip (dependant on mail.model)  -->
        <bundle>mvn:com.icg-software/com.icg-software.bsx.utils/${bsx.utils.version}</bundle>
        <bundle>mvn:com.icg-software/com.icg-software.integration.mail.model/${integration.mail.model.version}</bundle>
        <bundle>mvn:com.icg-software.bsx/com.icg-software.bsx.eip/${bsx.eip.version}</bundle>
        <bundle>mvn:com.icg-software/com.icg-software.bsx.db.common/${bsx.db.common.version}</bundle>
        <bundle>mvn:com.icg-software/com.icg-software.bsx.jms.connetionfactory.bsx/${bsx.jms.connetionfactory.bsx.version}</bundle>
        <bundle>mvn:com.icg-software/com.icg-software.bsx.karaf.commands/${bsx.karaf.commands.version}</bundle>
        <bundle>mvn:com.icg-software/com.icg-software.integration.delegatemail/${integration.delegatemail.version}</bundle>
        <bundle>mvn:com.icg-software/com.icg-software.integration.delegatemail.ssp.zerfdb/${integration.delegatemail.ssp.zerfdb.version}</bundle>
        <bundle>mvn:com.icg-software/com.icg-software.integration.sendmail/${integration.sendmail.version}</bundle>

        <bundle>mvn:com.icg-software/com.icg-software.integration.oracle.common/${oracle.common.version}</bundle>
    </feature>

    <feature name="bsx-base" version="${project.version}" description="BSX base OSGi dependencies" start-level="70">
        <feature>scr</feature>
        <feature>log</feature>
        <feature>hawtio</feature>
        <!-- provides jakarta.activation 2.1.4 (angus-activation) -->
        <feature>camel-core</feature>

        <!-- Utility libraries -->
        <bundle>mvn:org.jspecify/jspecify/${jspecify.version}</bundle>
        <bundle>mvn:com.google.guava/failureaccess/${failureaccess.version}</bundle>
        <bundle>mvn:com.google.guava/guava/${guava.version}</bundle>
        <bundle>mvn:com.google.code.gson/gson/${gson.version}</bundle>

        <!-- jakarta.activation -->
        <bundle>mvn:jakarta.xml.bind/jakarta.xml.bind-api/${jakarta.xml.bind-api.version}</bundle>
    </feature>


    <!-- for com.icg-software.bsx.db.common and later for bs-db features -->
    <feature name="bsx-database" version="${project.version}" description="Database drivers and connection pooling" start-level="70">
        <feature>transaction-manager-geronimo</feature>
        <feature>jasypt-encryption</feature>
        <feature>jpa</feature>
        <feature>hibernate</feature>
        <bundle>mvn:org.postgresql/postgresql/${postgres.version}</bundle>
        <bundle>mvn:com.h2database/h2/${h2.version}</bundle>
        <!-- for old stuff -->
        <bundle>mvn:com.h2database/h2/${h2.1.4.version}</bundle>
        <bundle>mvn:com.h2database/h2/${h2.2.0.version}</bundle>
        <bundle>mvn:org.apache.servicemix.bundles/org.apache.servicemix.bundles.dom4j/${dom4j-2.version}</bundle>

        <bundle>mvn:org.apache.commons/commons-pool2/${commons-pool2.version}</bundle>
        <bundle>mvn:org.apache.commons/commons-dbcp2/${commons-dbcp2.version}</bundle>

        <!-- for Tritom -->
        <bundle>wrap:mvn:org.firebirdsql.jdbc/jaybird-jdk18/${firebird.3.version}$Bundle-Name=Firebird 3 JDBC Driver&amp;Bundle-SymbolicName=org.firebirdsql.jdbc.jaybird&amp;Bundle-Version=${firebird.3.version}&amp;Export-Package=*;version=${firebird.3.version}</bundle> <!-- real bundle -->
        <bundle>wrap:mvn:org.firebirdsql.jdbc/jaybird/${firebird.4.version}$Bundle-Name=Firebird 4 JDBC Driver&amp;Bundle-SymbolicName=org.firebirdsql.jdbc.jaybird&amp;Bundle-Version=${firebird.4.version}&amp;Export-Package=*;version=${firebird.4.export.version}</bundle> <!-- real bundle -->
        <!-- FIXME: brauchen wir? >> text -->
        <!-- <bundle>mvn:com.microsoft.sqlserver/mssql-jdbc/${sqlserver.version}</bundle> -->
    </feature>

    <!-- for com.icg-software.bsx.jms.connetionfactory.bsx -->
    <feature name="bsx-jms" version="${project.version}" description="JMS connection factory (Artemis jakarta + pooled-jms)" start-level="70">
        <feature>artemis-jakarta-client</feature>
        <feature>bsx-netty</feature>
        <!-- pooled-jms 3.x uses jakarta.jms 3.1 namespace, compatible with artemis-jakarta-client -->
        <bundle>mvn:org.messaginghub/pooled-jms/${pooled-jms.version}</bundle>
    </feature>
    <!-- base Netty bundles (netty-common, netty-codec, netty-transport, etc.) are provided by artemis-jakarta-client via bsx-jms -->
    <feature name="bsx-netty" description="Additional Netty bundles not covered by Artemis" version="${pom.version}">
        <bundle>mvn:io.netty/netty-codec-http2/${netty.version}</bundle>
        <bundle>mvn:io.netty/netty-codec-dns/${netty.version}</bundle>
        <bundle>mvn:io.netty/netty-resolver-dns/${netty.version}</bundle>
        <bundle>mvn:io.netty/netty-codec-stomp/${netty.version}</bundle>
        <bundle>mvn:io.netty/netty-codec-mqtt/${netty.version}</bundle>
    </feature>

    <feature name="bsx-camel" version="${project.version}" description="Camel bundles" start-level="70">
        <!-- camel-core includes camel-api, camel-attachments, camel-file -->
        <feature>camel-core</feature>
        <feature>camel-blueprint</feature>
        <feature>camel-jasypt</feature>
        <feature>camel-zipfile</feature>
        <feature>camel-ftp</feature>
        <feature>camel-mail</feature>
        <feature>camel-quartz</feature>
        <feature>camel-csv</feature>
        <!-- only supports jakarta.jms namespace -->
        <feature>camel-jms</feature>

        <feature>bsx-camel2</feature>
    </feature>

    <feature name="bsx-camel2" version="${project.version}" description="More Camel bundles" start-level="70">
        <bundle>mvn:org.apache.groovy/groovy-jsr223/${groovy-bom.version}</bundle>
        <bundle>mvn:org.apache.groovy/groovy-json/${groovy-bom.version}</bundle>
        <bundle>mvn:org.apache.groovy/groovy-xml/${groovy-bom.version}</bundle>
        <bundle>mvn:org.apache.groovy/groovy-datetime/${groovy-bom.version}</bundle>
        <bundle>mvn:org.apache.groovy/groovy-nio/${groovy-bom.version}</bundle>
        <bundle>mvn:org.apache.groovy/groovy-dateutil/${groovy-bom.version}</bundle>
        <bundle>mvn:org.apache.groovy/groovy-sql/${groovy-bom.version}</bundle>

        <feature>camel-groovy</feature>

        <feature>camel-crypto</feature>
        <feature>camel-xmlsecurity</feature>
        <feature>camel-chunk</feature>
        <feature>camel-spring</feature>
        <feature>camel-stream</feature>
        <feature>camel-jsch</feature>
        <feature>camel-ssh</feature>
        <feature>camel-netty</feature>
        <feature>camel-netty-http</feature>
        <feature>camel-http</feature>
        <feature>camel-servlet</feature>
        <feature>camel-jaxb</feature>
        <feature>camel-saxon</feature>
        <feature>camel-soap</feature>
        <feature>camel-stax</feature>
        <feature>camel-jpa</feature>
        <feature>camel-jdbc</feature>
        <feature>camel-sql</feature>
        <feature>camel-reactive-streams</feature>
        <feature>camel-rxjava</feature>
        <!-- !!! OSGi only supports cxf v3 !!!
        this camel: cxf v4.1.5 see https://mvnrepository.com/artifact/org.apache.camel.karaf/camel-cxf-all
        for cxf v3 see https://mvnrepository.com/artifact/org.apache.camel/camel-cxf >> all camel would need to downgrade to camel v3! -->
        <!-- <feature>camel-cxf</feature> -->
    </feature>

    <feature name="bsx-apache-commons" version="${project.version}" description="Apache commons bundles" start-level="70">
        <bundle>mvn:org.apache.commons/commons-compress/${commons-compress.version}</bundle>
        <bundle>mvn:org.apache.commons/commons-lang3/${commons-lang3.version}</bundle>
        <bundle>mvn:org.apache.commons/commons-text/${commons-text.version}</bundle>
        <bundle>mvn:org.apache.commons/commons-vfs2/${commons-vfs2.version}</bundle>
        <!-- fragment for commons-vfs2 >> for reaching sftp inside keepass -->
        <bundle>mvn:eu.agno3.jcifs/jcifs-ng/${jcifs-ng.version}</bundle>
        <bundle>mvn:org.sodeac/org.sodeac.karaf.thirdparty.vfs-jcifs-ng/${sodeac.version}</bundle>

        <bundle>mvn:commons-io/commons-io/${commons-io.version}</bundle>
        <!-- commons-validator and its transitive dependencies -->
        <bundle>mvn:commons-collections/commons-collections/${commons-collections.version}</bundle>
        <bundle>mvn:commons-beanutils/commons-beanutils/${commons-beanutils.version}</bundle>
        <bundle>mvn:commons-digester/commons-digester/${commons-digester.version}</bundle>
        <bundle>mvn:commons-validator/commons-validator/${commons-validator.version}</bundle>

        <!-- not needed by core-bsx -->
        <feature>bsx-apache-commons2</feature>
    </feature>


    <feature name="bsx-apache-commons2" version="${project.version}" description="More Apache commons bundles" start-level="70">
        <bundle>mvn:org.apache.commons/commons-configuration2/${commons-configuration2.version}</bundle>
        <bundle>mvn:org.apache.commons/commons-csv/${commons-csv.version}</bundle>
        <bundle>mvn:commons-dbutils/commons-dbutils/${commons-dbutils.version}</bundle>
        <bundle>mvn:commons-codec/commons-codec/${commons-codec.version}</bundle>
        <bundle>mvn:commons-net/commons-net/${commons-net.version}</bundle>
        <bundle>mvn:org.apache.commons/commons-math3/${commons-math3.version}</bundle>
        <bundle>mvn:org.apache.commons/commons-collections4/${commons-collections4.version}</bundle>
        <bundle>mvn:commons-logging/commons-logging/${commons-logging.version}</bundle>
        <bundle>mvn:org.apache.commons/commons-jexl3/${commons-jexl3.version}</bundle>
        <bundle>mvn:commons-cli/commons-cli/${commons-cli.version}</bundle>

        <bundle>mvn:org.apache.httpcomponents/httpcore-osgi/${commons-httpcore}</bundle>
        <bundle>mvn:org.apache.httpcomponents/httpasyncclient-osgi/${commons-httpasyncclient}</bundle>
        <bundle>mvn:org.apache.httpcomponents/httpclient-osgi/${commons-httpclient}</bundle>
    </feature>

    <feature name="bsx-jackson" version="${project.version}" description="Jackson JSON/XML databinding" start-level="70">
        <!-- annotations uses major.minor only (since Jackson 2.20) -->
        <bundle>mvn:com.fasterxml.jackson.core/jackson-annotations/${jackson-annotations.version}</bundle>
        <bundle>mvn:com.fasterxml.jackson.core/jackson-core/${jackson-bom.version}</bundle>
        <bundle>mvn:com.fasterxml.jackson.core/jackson-databind/${jackson-bom.version}</bundle>
        <bundle>mvn:com.fasterxml.jackson.datatype/jackson-datatype-jsr310/${jackson-bom.version}</bundle>
        <!-- XML support with jackson-dataformat-xml: stax2-api (API) + woodstox-core (implementation);
        dependency="true" so Karaf skips them if already provided (via camel-core/xml-specs-api) -->
        <bundle dependency="true">mvn:org.codehaus.woodstox/stax2-api/${stax2-api.version}</bundle>
        <bundle dependency="true">mvn:com.fasterxml.woodstox/woodstox-core/${jackson.version.dep.woodstox}</bundle>
        <bundle>mvn:com.fasterxml.jackson.dataformat/jackson-dataformat-xml/${jackson-bom.version}</bundle>
    </feature>

    <!-- Sodeac -->
    <feature name="bsx-sodeac" version="${project.version}" description="All Sodeac features combined" start-level="75">
        <feature>sodeac-common</feature>
        <feature>sodeac-dbschema</feature>
        <feature>sodeac-streampartitioner</feature>
        <feature>sodeac-eventdispatcher</feature>
        <bundle>mvn:org.sodeac/org.sodeac.karaf.sftphome/${sodeac.version}</bundle>
    </feature>

    <feature name="sodeac-common" version="${project.version}" description="Sodeac common bundle" start-level="75">
        <feature>bsx-base</feature>
        <!-- prerequisite: sodeac.common uses jakarta.json (glassfish RI, matches sodeac compile dependency) -->
        <bundle>mvn:org.glassfish/jakarta.json/${glassfish.jakarta.json.version}</bundle>
        <bundle>mvn:org.sodeac/org.sodeac.common/${sodeac.version}</bundle>
    </feature>

    <feature name="sodeac-dbschema" version="${project.version}" description="Sodeac DB schema management" start-level="75">
        <feature>sodeac-common</feature>
        <bundle>mvn:org.sodeac/org.sodeac.dbschema.api/${sodeac.version}</bundle>
        <bundle>mvn:org.sodeac/org.sodeac.dbschema.provider/${sodeac.version}</bundle>
        <bundle>mvn:org.sodeac/org.sodeac.dbschema.driver.base/${sodeac.version}</bundle>
        <bundle>mvn:org.sodeac/org.sodeac.dbschema.driver.h2/${sodeac.version}</bundle>
        <bundle>mvn:org.sodeac/org.sodeac.dbschema.driver.postgresql/${sodeac.version}</bundle>
        <!-- <bundle>mvn:org.sodeac/org.sodeac.dbschema.driver.oracle/${sodeac.version}</bundle> -->
    </feature>

    <feature name="sodeac-streampartitioner" version="${project.version}" description="Sodeac stream partitioner" start-level="75">
        <feature>sodeac-common</feature>
        <bundle>mvn:org.sodeac/org.sodeac.streampartitioner.api/${sodeac.version}</bundle>
        <bundle>mvn:org.sodeac/org.sodeac.streampartitioner.provider/${sodeac.version}</bundle>
        <!-- <bundle>mvn:org.sodeac/org.sodeac.streampartitioner.example/${sodeac.version}</bundle> -->
    </feature>

    <feature name="sodeac-eventdispatcher" version="${project.version}" description="Sodeac event dispatcher" start-level="75">
        <feature>sodeac-common</feature>
        <!-- prerequisites -->
        <bundle>mvn:org.sodeac/org.sodeac.multichainlist/${sodeac.multichainlist.version}</bundle>
        <bundle>mvn:org.sodeac/org.sodeac.xuri/${sodeac.xuri.version}</bundle>
        <bundle>mvn:io.dropwizard.metrics/metrics-core/${dropwizard.metrics.version}</bundle>
        <!-- event dispatcher bundles -->
        <bundle>mvn:org.sodeac/org.sodeac.eventdispatcher.api/${sodeac.version}</bundle>
        <bundle>mvn:org.sodeac/org.sodeac.eventdispatcher.common/${sodeac.version}</bundle>
        <bundle>mvn:org.sodeac/org.sodeac.eventdispatcher.provider/${sodeac.version}</bundle>
        <bundle>mvn:org.sodeac/org.sodeac.eventdispatcher.extension.jmx/${sodeac.version}</bundle>
    </feature>


