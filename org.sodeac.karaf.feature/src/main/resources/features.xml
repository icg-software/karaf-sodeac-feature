        <!-- Jackson JAX-RS providers: require javax.ws.rs (via cxf-specs), so they belong here -->
        <bundle dependency="true">mvn:com.fasterxml.jackson.jaxrs/jackson-jaxrs-base/${jackson-bom.version}</bundle>
        <bundle dependency="true">mvn:com.fasterxml.jackson.jaxrs/jackson-jaxrs-json-provider/${jackson-bom.version}</bundle>
        <bundle start-level="40">mvn:com.fasterxml.jackson.module/jackson-module-jaxb-annotations/${jackson-bom.version}</bundle>

        <bundle dependency="true">mvn:org.apache.cxf.karaf/cxf-karaf-commands/${cxf.version}</bundle>
        <bundle start-level="40">mvn:org.apache.servicemix.specs/org.apache.servicemix.specs.annotation-api-1.3/${annotation-api-1.3.version}</bundle>
    </feature>

    <!-- keycloak -->
