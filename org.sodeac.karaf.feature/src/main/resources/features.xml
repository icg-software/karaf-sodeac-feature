    <!-- Optional features for projects deployed to Karaf alongside bsx -->
    <feature name="bsx2" description="Optional extensions for projects deployed to Karaf alongside bsx" version="${pom.version}">
        <feature>bsx2-jackson2</feature>
        <feature>bsx2-security</feature>
        <feature>bsx2-jaxws</feature>
        <feature>bsx2-cxf</feature>
